{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_archive/**",
      "docs/**",
      "*.ps1",
      "firestore.rules",
      "image-manifest*.json",
      "monster-progress*.json",
      "_*.json",
      "README.md"
    ],
    "rewrites": [
      { "source": "/", "destination": "/app.html" }
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      }
    ]
  }
}
